{
  "name": "ads1115",
  "author": "WhirlingBits",
  "pins": [
    {
      "name": "VDD",
      "description": "Power supply (+3.3V to +5V)"
    },
    {
      "name": "GND",
      "description": "Ground"
    },
    {
      "name": "SCL",
      "description": "I2C Clock line"
    },
    {
      "name": "SDA",
      "description": "I2C Data line"
    },
    {
      "name": "ADDR",
      "description": "I2C Address Selection (GND=0x48, VDD=0x49, SDA=0x4A, SCL=0x4B)"
    },
    {
      "name": "ALRT",
      "description": "Alert/Ready output"
    },
    {
      "name": "A0",
      "description": "Analog Input 0 (0-5V, ADC settable)"
    },
    {
      "name": "A1",
      "description": "Analog Input 1 (0-5V, ADC settable)"
    },
    {
      "name": "A2",
      "description": "Analog Input 2 (0-5V, ADC settable)"
    },
    {
      "name": "A3",
      "description": "Analog Input 3 (0-5V, ADC settable)"
    }
  ],
  "controls": [
    {
      "type": "slider",
      "label": "A0 Voltage (V)",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "id": "v0",
      "format": "volt"
    },
    {
      "type": "slider",
      "label": "A1 Voltage (V)",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "id": "v1",
      "format": "volt"
    },
    {
      "type": "slider",
      "label": "A2 Voltage (V)",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "id": "v2",
      "format": "volt"
    },
    {
      "type": "slider",
      "label": "A3 Voltage (V)",
      "min": 0,
      "max": 5,
      "step": 0.1,
      "id": "v3",
      "format": "volt"
    }
  ],
  "notes": "I2C Address Selection: Connect ADDR pin to GND (0x48), VDD (0x49), SDA (0x4A), or SCL (0x4B). Default: 0x48 when floating/low."
}