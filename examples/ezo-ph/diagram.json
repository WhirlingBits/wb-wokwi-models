{
  "version": 1,
  "author": "WhirlingBits Example",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-s3-devkitc-1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "chip-ezo-ph",
      "id": "ph1",
      "top": -90,
      "left": 200,
      "attrs": { "ph": "700" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "esp:4", "ph1:TX-SDA", "green", [ "v0" ] ],
    [ "esp:5", "ph1:RX-SCL", "blue", [ "v0" ] ],
    [ "esp:3V3", "ph1:VCC", "red", [ "v20", "h40" ] ],
    [ "esp:GND", "ph1:GND", "black", [ "v30", "h50" ] ]
  ],
  "dependencies": {}
}
